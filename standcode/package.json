  "license": "Apache-2.0",
  "author": "bb4407777",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bb4407777/standcode.git",
    "directory": "standcode"
  },
  "keywords": ["agent", "orchestration", "multi-agent", "areco", "cli", "dispatcher"],
  "bin": { "standcode": "bin/standcode.js" },
  "files": [
    "bin/",
    "caller/caller.py",
    "config/harnesses.example.json",
    "config/models.json",
    "config/presets.json",
    "stand/registry.json",
    "requirements.txt",
    "README.md",
    "LICENSE"
  ],
  "engines": { "node": ">=18" },
  "scripts": {
    "test": "bash scripts/run-tests.sh",
