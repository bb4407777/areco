<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- secretary-01 headless 秘书分身 gateway（持久化用，尚未 bootstrap）。
     启用：launchctl bootstrap gui/$(id -u) /Users/gao/Library/LaunchAgents/ai.hermes.gateway.secretary.plist
     （带 --replace，bootstrap 时会自动接管当前 8646 上的 nohup 实例）
     停用：launchctl bootout gui/$(id -u)/ai.hermes.gateway.secretary -->
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>API_SERVER_KEY</key>
		<string>hermes-secretary-key</string>
		<key>API_SERVER_MODEL_NAME</key>
		<string>k3</string>
		<key>API_SERVER_PORT</key>
		<string>8646</string>
		<key>HERMES_HOME</key>
		<string>/Users/gao/.qclaw-hermes/profiles/secretary-01</string>
		<key>PATH</key>
		<string>/usr/local/bin:/Users/gao/scripts:/Library/Frameworks/Python.framework/Versions/3.12/bin:/Users/gao/.npm-global/bin:/Users/gao/bin:/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin</string>
	</dict>
	<key>KeepAlive</key>
	<true/>
	<key>Label</key>
	<string>ai.hermes.gateway.secretary</string>
	<key>LimitLoadToSessionType</key>
	<array>
		<string>Aqua</string>
		<string>Background</string>
	</array>
	<key>ProgramArguments</key>
	<array>
		<string>/Library/Frameworks/Python.framework/Versions/3.12/bin/python3.12</string>
		<string>-m</string>
		<string>hermes_cli.main</string>
		<string>gateway</string>
		<string>run</string>
		<string>--replace</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/Users/gao/.qclaw-hermes/profiles/secretary-01/logs/gateway.error.log</string>
	<key>StandardOutPath</key>
	<string>/Users/gao/.qclaw-hermes/profiles/secretary-01/logs/gateway.log</string>
	<key>WorkingDirectory</key>
	<string>/Users/gao/.qclaw-hermes/profiles/secretary-01</string>
</dict>
</plist>
