#!/usr/bin/expect -f
# expect TUI 驱动骨架（2026-07-30 kimi-code 插件安装实战定版）
# 用法：复制后改 SPAWN_CMD / READY_RE / 动作序列三段。
set timeout 60
log_file -noappend /tmp/tui-driver.log

# 1) 启动目标程序
spawn <SPAWN_CMD，如 /path/to/cli>

# 2) 等 TUI 就绪标志（状态栏固定文字），看不到就退出别硬打
expect {
    -re "<READY_RE，如 yolo  K3>" { }
    timeout { puts "TIMEOUT waiting for TUI ready"; exit 1 }
}
sleep 5   ;# 就绪后再等几秒，防重绘偷键

# 3) 逐字符输入命令（自动补全稳定），再单独发提交键
foreach c [split "/some-command" ""] {
    send -- $c
    sleep 0.2
}
sleep 2
send -- "\n"   ;# 提交键：新版本 TUI 多用 \n；旧版可能只认 \r，不灵就换

# 4) 等目标画面出现再操作面板
expect {
    -re "<PANEL_MARK_RE>" { puts "PANEL OPEN" }
    timeout { puts "TIMEOUT waiting for panel"; exit 1 }
}
sleep 3
send -- "\t"    ;# 切 Tab
sleep 4
send -- "\r"    ;# 选中/确认
set timeout 240
expect {
    -re "<DONE_RE，如 installed>" { puts "DONE" }
    timeout { puts "TIMEOUT waiting for action"; }
}
sleep 5

# 5) 退出
send -- "\033"
sleep 2
send -- "/exit"
sleep 1
send -- "\r"
sleep 4
expect eof

