# ~/.qclaw-hermes/.env — Hermes 主 gateway 环境变量（键名快照 2026-08-02，值全占位）
# 真身含通道 id 与密钥，不入仓；复原时按本模板逐键填写。
HERMES_API_CALL_STALE_TIMEOUT=<秒数，如 600>
HERMES_API_TIMEOUT=<秒数，如 300>
WEIXIN_HOME_CHANNEL=<weixin:dm:xxxx@im.wechat 主通道会话 id>
WEIXIN_HOME_CHANNEL_THREAD_ID=<主通道 thread id，无则留空>
FEISHU_APP_ID=<飞书应用 id；FEISHU_APP_SECRET 由 hermes 侧另行注入，缺失时 lark 绑定会被阻塞>
