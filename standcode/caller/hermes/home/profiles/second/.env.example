# ~/.qclaw-hermes/profiles/second/.env — second 分身环境变量（键名快照 2026-08-02，值全占位）
# 真身含微信通道凭证与 API key，不入仓。secretary-01 profile 与本文件同构（克隆关系）。
HERMES_API_CALL_STALE_TIMEOUT=<秒数>
HERMES_API_TIMEOUT=<秒数>
FEISHU_APP_ID=<飞书应用 id>
WEIXIN_ACCOUNT_ID=<微信账号 id>
WEIXIN_TOKEN=<微信通道 token>
WEIXIN_BASE_URL=<ilink base url>
WEIXIN_CDN_BASE_URL=<ilink cdn base url>
WEIXIN_DM_POLICY=<dm 策略，如 allowlist>
WEIXIN_ALLOW_ALL_USERS=<true|false>
WEIXIN_ALLOWED_USERS=<允许的用户 id 列表>
WEIXIN_GROUP_POLICY=<群策略>
WEIXIN_GROUP_ALLOWED_USERS=<允许的群成员列表>
WEIXIN_HOME_CHANNEL=<该分身主通道会话 id>
API_SERVER_KEY=<该分身 api_server 的 Bearer key（8643/8646 端口鉴权）>
