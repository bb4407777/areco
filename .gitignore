node_modules/
dist/
data/
config.json
# 本机 agent 启动器（绝对路径/私有配置），不入仓；仅忽略底座 bin/，子目录 bin/（如 workbuddy-gpt56/bin/ 源码）正常入仓
/bin/
*.log
.DS_Store

# CodeGraph 本地可重建索引（数据库体积大，不入仓）
.codegraph/
**/.codegraph/


# worktree 里以 symlink 形式存在的共享运行态（symlink 对 git 是文件不是目录，
# 上面的目录型 pattern（data/、/bin/、node_modules/）匹配不到，需文件型补一条）
/data
/bin
/node_modules

# 手工备份/临时文件禁入库与发布包（2026-08-02 检查报告 P2-5：npm pack 曾夹带 7 个 registry.json.bak*）
*.bak
*.bak-*
*.bak.*
*.orig
*.swp

# Understand-Anything 图谱输出(23MB 生成物,重跑可再生)
/.ua/
__pycache__/

# StandCode 退役后运行配置迁居仓根 config/（含凭证/本机路径，只入 *.example.json）
/config/harnesses.json
/config/providers.json
/config/local.json
/config/models.json
/config/presets.json
