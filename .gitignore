node_modules/
dist/
data/
config.json
# 本机 agent 启动器（绝对路径/私有配置），不入仓；仅忽略 areco 底座 bin/，子目录 bin/（如 workbuddy-gpt56/bin/ 源码）正常入仓
/areco/bin/
*.log
.DS_Store

# CodeGraph 本地可重建索引（数据库体积大，不入仓）
.codegraph/
**/.codegraph/

# StandCode 本机私有配置（真身含凭证/本机路径，仓里只放 *.example.json）
standcode/config/harnesses.json
standcode/config/providers.json
standcode/config/local.json

# Hermes 收编目录防呆：真配置/真凭证永不入仓（仓里只放 *.example.*）
standcode/caller/hermes/**/config.yaml
standcode/caller/hermes/**/auth.json

# worktree 里以 symlink 形式存在的共享运行态（symlink 对 git 是文件不是目录，
# 上面的目录型 pattern（data/、/areco/bin/、node_modules/）匹配不到，需文件型补一条）
/areco/data
/areco/bin
/areco/node_modules
/standcode/data

# 手工备份/临时文件禁入库与发布包（2026-08-02 检查报告 P2-5：npm pack 曾夹带 7 个 registry.json.bak*）
*.bak
*.bak-*
*.bak.*
*.orig
*.swp

# Understand-Anything 图谱输出(23MB 生成物,重跑可再生)
/.ua/
